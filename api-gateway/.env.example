# API Gateway Environment Variables

NODE_ENV=development
PORT=3001

# Service URLs
AUTH_SERVICE_URL=http://auth-service:3002
USER_SERVICE_URL=http://user-service:3003
CONTENT_SERVICE_URL=http://content-service:3004
MOOD_SERVICE_URL=http://mood-service:3005
CHAT_SERVICE_URL=http://chat-service:3006
MODERATION_SERVICE_URL=http://moderation-service:3007
WELLNESS_SERVICE_URL=http://wellness-service:3008
PROFESSIONAL_SERVICE_URL=http://professional-service:3009
MEDIA_SERVICE_URL=http://media-service:3010
NOTIFICATION_SERVICE_URL=http://notification-service:3011

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:80

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

