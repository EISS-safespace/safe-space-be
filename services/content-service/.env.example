# ============================================
# Content Service - Environment Configuration
# ============================================

# Server Configuration
PORT=3004
NODE_ENV=development

# Database Configuration
# For local development (PostgreSQL on host)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safespace_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# For Docker deployment (uncomment and comment above)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/safespace_db

# Service URLs
# For local development
AUTH_SERVICE_URL=http://localhost:3002
MODERATION_SERVICE_URL=http://localhost:3007
MEDIA_SERVICE_URL=http://localhost:3010

# For Docker deployment (uncomment and comment above)
# AUTH_SERVICE_URL=http://auth-service:3002
# MODERATION_SERVICE_URL=http://moderation-service:3007
# MEDIA_SERVICE_URL=http://media-service:3010

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Pagination Configuration
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Content Moderation
AUTO_APPROVE_HOPE_STORIES=false
PROFANITY_FILTER_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend URL
FRONTEND_URL=http://localhost:3000

