# Test Environment Configuration for Content Service

# Server
PORT=3004
NODE_ENV=test

# Database (Use in-memory SQLite for tests)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safespace_content_test
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# Auth Service
AUTH_SERVICE_URL=http://localhost:3002

# CORS
CORS_ORIGIN=http://localhost:3000

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Content Moderation
AUTO_APPROVE_HOPE_STORIES=false
PROFANITY_FILTER_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

