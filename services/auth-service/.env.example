# ============================================
# Auth Service - Environment Configuration
# ============================================

# Server Configuration
PORT=3002
NODE_ENV=development

# Database Configuration
# For local development (PostgreSQL on host)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safespace_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# For Docker deployment (uncomment and comment above)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/safespace_db

# Redis Configuration
# For local development
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# For Docker deployment (uncomment and comment above)
# REDIS_URL=redis://:redis123@redis:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@safespace.com

# Security Configuration
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000
VERIFICATION_TOKEN_EXPIRY=86400000
PASSWORD_RESET_TOKEN_EXPIRY=3600000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

