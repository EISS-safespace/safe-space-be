# ============================================
# Media Service - Environment Configuration
# ============================================

# Server Configuration
PORT=3010
NODE_ENV=development

# Database Configuration
# For local development (PostgreSQL on host)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safespace_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# For Docker deployment (uncomment and comment above)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/safespace_db

# Service URLs
# For local development
AUTH_SERVICE_URL=http://localhost:3002

# For Docker deployment (uncomment and comment above)
# AUTH_SERVICE_URL=http://auth-service:3002

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp
MAX_FILES_PER_UPLOAD=5

# Image Processing Configuration
IMAGE_MAX_WIDTH=1200
IMAGE_MAX_HEIGHT=1200
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=300
IMAGE_QUALITY=85

# AWS S3 Configuration (Optional - for cloud storage)
# Leave empty to use local file storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=safespace-media
AWS_CLOUDFRONT_URL=

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=50

# Frontend URL
FRONTEND_URL=http://localhost:3000

