# ============================================
# SafeSpace - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# General
# ============================================
NODE_ENV=development
# Options: development, staging, production

# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=safespace_db

# ============================================
# Redis
# ============================================
REDIS_PASSWORD=your-secure-redis-password

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# API Gateway
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
# Frontend URL for email verification and password reset links

# ============================================
# AI Moderation (OpenAI)
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# Email (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_NAME=SafeSpace
SMTP_FROM_EMAIL=noreply@safespace.com

# ============================================
# AWS S3 (Media Storage)
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=safespace-media
AWS_CLOUDFRONT_URL=https://your-cloudfront-domain.cloudfront.net

# ============================================
# Media Upload Configuration
# ============================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
# 5MB in bytes
MAX_IMAGE_SIZE=5242880
# 5MB in bytes
MAX_AUDIO_SIZE=10485760
# 10MB in bytes
IMAGE_QUALITY=80
# JPEG/WebP quality (0-100)
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=300
MAX_IMAGES_PER_POST=5

# ============================================
# Firebase (Push Notifications)
# ============================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ============================================
# OAuth (Optional)
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================
# Authentication Settings
# ============================================
MAX_LOGIN_ATTEMPTS=5
# Maximum failed login attempts before account lockout
LOCKOUT_DURATION=900000
# Account lockout duration in milliseconds (15 minutes)
VERIFICATION_TOKEN_EXPIRY=86400000
# Email verification token expiry in milliseconds (24 hours)
PASSWORD_RESET_TOKEN_EXPIRY=3600000
# Password reset token expiry in milliseconds (1 hour)

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100
# Maximum requests per window for general endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds for auth endpoints
AUTH_RATE_LIMIT_MAX_REQUESTS=5
# Maximum auth requests per window (stricter for security)

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:80
# Comma-separated list of allowed origins

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
# Options: error, warn, info, debug

# ============================================
# SSL/TLS (Production)
# ============================================
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ============================================
# Monitoring
# ============================================
SENTRY_DSN=your-sentry-dsn-here
# Optional: For error tracking

# ============================================
# Backup
# ============================================
BACKUP_SCHEDULE=0 2 * * *
# Cron format: Daily at 2 AM
BACKUP_RETENTION_DAYS=30

