# Bcrypt Configuration
BCRYPT_ROUNDS=10

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# AI Configuration (Optional)
OPENAI_API_KEY=

# Upload Configuration
MAX_FILE_SIZE=5242880

