# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_NAME=safespace_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
